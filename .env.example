PAPERFORGE_ENVIRONMENT=development
PAPERFORGE_SERVICE_NAME=paperforge-api
PAPERFORGE_LOG_LEVEL=INFO
PAPERFORGE_LOG_FORMAT=json
PAPERFORGE_HOST=0.0.0.0
PAPERFORGE_PORT=8000
PAPERFORGE_RELOAD=true

POSTGRES_DB=paperforge
POSTGRES_USER=paperforge
POSTGRES_PASSWORD=paperforge-local-only
AIRFLOW_DB=paperforge_airflow
PAPERFORGE_DATABASE__URL=postgresql+psycopg://paperforge:paperforge-local-only@postgres:5432/paperforge
PAPERFORGE_DATABASE__ECHO=false
PAPERFORGE_DATABASE__POOL_SIZE=5
PAPERFORGE_DATABASE__MAX_OVERFLOW=5
PAPERFORGE_DATABASE__CONNECT_TIMEOUT_SECONDS=3

PAPERFORGE_OPENSEARCH__ENABLED=true
PAPERFORGE_OPENSEARCH__REQUIRED=true
PAPERFORGE_OPENSEARCH__URL=http://opensearch:9200
PAPERFORGE_OPENSEARCH__INDEX_NAME=paperforge-papers-v1
PAPERFORGE_OPENSEARCH__TIMEOUT_SECONDS=5

PAPERFORGE_REDIS__ENABLED=true
PAPERFORGE_REDIS__REQUIRED=false
PAPERFORGE_REDIS__URL=redis://redis:6379/0
PAPERFORGE_REDIS__CONNECT_TIMEOUT_SECONDS=2
PAPERFORGE_REDIS__SOCKET_TIMEOUT_SECONDS=2
PAPERFORGE_REDIS__DEFAULT_TTL_SECONDS=21600

PAPERFORGE_OLLAMA__ENABLED=false
PAPERFORGE_OLLAMA__REQUIRED=false
PAPERFORGE_OLLAMA__URL=http://ollama:11434
PAPERFORGE_OLLAMA__TIMEOUT_SECONDS=3

PAPERFORGE_ARXIV__BASE_URL=https://export.arxiv.org/api/query
PAPERFORGE_ARXIV__CATEGORY=cs.AI
PAPERFORGE_ARXIV__MAX_RESULTS=15
PAPERFORGE_ARXIV__REQUEST_TIMEOUT_SECONDS=30
PAPERFORGE_ARXIV__RATE_LIMIT_SECONDS=3
PAPERFORGE_ARXIV__MAX_RETRIES=3
PAPERFORGE_ARXIV__RETRY_BACKOFF_SECONDS=2
PAPERFORGE_ARXIV__USER_AGENT=paperforge/0.3.0
PAPERFORGE_ARXIV__PDF_CACHE_DIR=/workspace/data/arxiv_pdfs
PAPERFORGE_ARXIV__MAX_PDF_DOWNLOAD_MB=25

PAPERFORGE_DOCUMENT_PARSER__ENABLED=true
PAPERFORGE_DOCUMENT_PARSER__MAX_PAGES=30
PAPERFORGE_DOCUMENT_PARSER__MAX_FILE_SIZE_MB=20
PAPERFORGE_DOCUMENT_PARSER__DO_OCR=false
PAPERFORGE_DOCUMENT_PARSER__DO_TABLE_STRUCTURE=true

PAPERFORGE_INGESTION__MAX_CONCURRENT_DOWNLOADS=2
PAPERFORGE_INGESTION__MAX_CONCURRENT_PARSES=1
PAPERFORGE_INGESTION__PDF_RETENTION_DAYS=30
